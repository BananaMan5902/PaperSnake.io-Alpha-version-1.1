<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paper Snake</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main id="game">
    <canvas id="gameCanvas" aria-label="Paper Snake game"></canvas>

    <section class="hud">
      <div class="brand">PAPER SNAKE</div>

      <div class="stats">
        <div class="stat">
          <span>Territory</span>
          <strong id="territory">0.0%</strong>
        </div>
        <div class="stat">
          <span>Length</span>
          <strong id="length">10</strong>
        </div>
        <div class="stat">
          <span>Kills</span>
          <strong id="kills">0</strong>
        </div>
        <div class="stat">
          <span>CPUs</span>
          <strong id="cpuCount">0</strong>
        </div>
      </div>

      <div class="progress">
        <div id="progressFill"></div>
      </div>
    </section>

    <canvas id="minimap" aria-label="World minimap"></canvas>

    <div class="controls">
      <b>WASD / ARROWS</b> Move
      <span>SPACE / SHIFT</span> Sprint — consumes length
      <span>Close your trail</span> Capture land
    </div>

    <div id="notice" role="status"></div>

    <div id="gameOver" class="overlay hidden">
      <div class="result">
        <h1 id="resultTitle">Game Over</h1>
        <p id="resultText"></p>
        <button id="restartButton" type="button">Play Again</button>
      </div>
    </div>
  </main>

  <script src="game.js"></script>
</body>
</html>
